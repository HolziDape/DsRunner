# DsRunner Stream: Einstellungen fuer start.sh, den Dienst und den Autostart.
# Nach ~/.config/dsstream.env kopieren und anpassen.

# Adresse des Spiels, "test" = eingebaute Testseite
DSSTREAM_URL="test"

# 256x192 (ein Bildschirm), 128x96 (schneller, groeber), 256x384 (beide Bildschirme)
DSSTREAM_MODE="256x192"

# Tastenbelegung aus stream/host/mappings/ oder ein eigener Pfad
DSSTREAM_MAPPING="default.json"

# weitere Optionen, siehe: python -m dsstream --help
# --gpu: GPU fuer WebGL; --fps 15: weniger Bilder; --mute: Ton am Pi aus
DSSTREAM_EXTRA="--gpu"

# Python mit den installierten Paketen (venv aus der Anleitung)
DSSTREAM_PYTHON="$HOME/dsstream-venv/bin/python"
