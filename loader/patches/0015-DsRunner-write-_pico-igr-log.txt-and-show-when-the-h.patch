diff --git a/arm7/source/fat/igrLog.cpp b/arm7/source/fat/igrLog.cpp
new file mode 100644
index 0000000..4aeefaa
--- /dev/null
+++ b/arm7/source/fat/igrLog.cpp
@@ -0,0 +1,216 @@
+#include "common.h"
+#include <memory>
+#include <stdarg.h>
+#include <string.h>
+#include "core/mini-printf.h"
+#include "inGameReset.h"
+#include "igrLog.h"
+
+// DsRunner: see igrLog.h
+
+#define IGR_LOG_PATH    "/_pico/igr-log.txt"
+
+#ifndef DSRUNNER_BUILD_ID
+#define DSRUNNER_BUILD_ID   "unknown"
+#endif
+
+igr_log_state_t gIgrLog;
+
+static const char* const sBootModeTexts[] =
+{
+    "normal start",
+    "start after the in-game reset (PIGR): booting the launcher",
+    "start after the game's own soft reset (OS_ResetSystem): same game again",
+    "multiboot"
+};
+
+static const char* const sDldiTexts[] =
+{
+    "card not mounted",
+    "DLDI init failed",
+    "handed down by the launcher, saved to /_pico/dldi.bin",
+    "handed down by the launcher, /_pico/dldi.bin is up to date",
+    "handed down by the launcher, but not cacheable (NOT saved)",
+    "handed down by the launcher, writing /_pico/dldi.bin FAILED",
+    "none handed down, loaded /_pico/dldi.bin",
+    "none handed down and no /_pico/dldi.bin",
+    "none handed down and /_pico/dldi.bin is invalid"
+};
+
+static const char* const sLauncherTexts[] =
+{
+    "-",
+    "saved to /_pico/launcher.txt",
+    "/_pico/launcher.txt is up to date",
+    "writing /_pico/launcher.txt FAILED",
+    "the launcher handed down no path (NOT saved, the hotkey can't return)",
+    "from the loader header",
+    "from /_pico/launcher.txt",
+    "fallback, /_pico/launcher.txt missing or pointing to a missing file",
+    "NOT FOUND"
+};
+
+static const char* const sStatusTexts[] =
+{
+    "not patched (not reported by the arm9)",
+    "NOT applied: switched off by /_pico/igr.off (settings.json \"inGameReset\": false)",
+    "NOT applied: the rom has no sdk version, no arm9 patches",
+    "NOT applied: no known irq dispatcher found",
+    "NOT applied: game has no OS_ResetSystem and there is no sd read code for the reboot",
+    "NOT applied: not enough patch space",
+    "applied"
+};
+
+static const char* const sMatchTexts[] =
+{
+    "not tried",
+    "no match",
+    "ambiguous (more than one match)",
+    "dispatcher start not found",
+    "return address mismatch",
+    "invalid irq table",
+    "MATCH",
+    "pattern found, rejected by a check",
+    "?", "?", "?", "?", "?", "?", "?", "?"
+};
+
+static const char* const sVariantNames[DSRUNNER_IGR_VARIANT_COUNT] =
+{
+    "sdk", "blx", "nested", "condreturn"
+};
+
+template <typename T, u32 N>
+static const char* textOf(const T (&texts)[N], u32 index)
+{
+    return index < N ? texts[index] : "?";
+}
+
+/// @brief Collects the text in a fixed buffer; output that does not fit is dropped.
+class IgrLogText
+{
+public:
+    void Add(const char* format, ...)
+    {
+        va_list args;
+        va_start(args, format);
+        int length = mini_vsnprintf(_buffer + _length, sizeof(_buffer) - _length, format, args);
+        va_end(args);
+        if (length > 0)
+        {
+            _length += length;
+            if (_length > sizeof(_buffer) - 1)
+            {
+                _length = sizeof(_buffer) - 1;
+            }
+        }
+    }
+
+    const char* GetText() const { return _buffer; }
+    u32 GetLength() const { return _length; }
+
+private:
+    char _buffer[1536];
+    u32 _length = 0;
+};
+
+static void addRomInfo(IgrLogText& text, const char* romPath, const nds_header_ntr_t* romHeader, bool isHomebrew)
+{
+    char title[sizeof(romHeader->gameTitle) + 1];
+    memcpy(title, romHeader->gameTitle, sizeof(romHeader->gameTitle));
+    title[sizeof(romHeader->gameTitle)] = 0;
+    for (u32 i = 0; i < sizeof(romHeader->gameTitle); i++)
+    {
+        if (title[i] != 0 && (title[i] < 0x20 || title[i] > 0x7E))
+            title[i] = '?';
+    }
+    char gameCode[5];
+    memcpy(gameCode, &romHeader->gameCode, 4);
+    gameCode[4] = 0;
+    for (u32 i = 0; i < 4; i++)
+    {
+        if (gameCode[i] < 0x20 || gameCode[i] > 0x7E)
+            gameCode[i] = '?';
+    }
+    text.Add("rom: %s\r\n", romPath ? romPath : "(same rom as before the reset)");
+    text.Add("game: %s \"%s\" (%s)\r\n", gameCode, title, isHomebrew ? "homebrew" : "retail");
+}
+
+static void addPatchInfo(IgrLogText& text, const dsrunner_igr_diag_t* diag)
+{
+    char platform[sizeof(diag->platform) + 1];
+    memcpy(platform, diag->platform, sizeof(diag->platform));
+    platform[sizeof(diag->platform)] = 0;
+    text.Add("platform: %s\r\n", platform);
+    text.Add("sdk version: 0x%X\r\n", diag->sdkVersion);
+    text.Add("OS_ResetSystem: %s (0x%X)\r\n", diag->osResetSystem ? "found" : "not found", diag->osResetSystem);
+    text.Add("in-game reset: %s\r\n", textOf(sStatusTexts, diag->status));
+    for (u32 i = 0; i < DSRUNNER_IGR_VARIANT_COUNT; i++)
+    {
+        u32 result = (diag->matchResults >> (i * 4)) & 0xF;
+        if (i == DSRUNNER_IGR_VARIANT_SDK)
+        {
+            text.Add("  dispatcher %s: %s (pattern found %d times)\r\n", sVariantNames[i],
+                textOf(sMatchTexts, result), diag->sdkPatternCount);
+        }
+        else
+        {
+            text.Add("  dispatcher %s: %s\r\n", sVariantNames[i], textOf(sMatchTexts, result));
+        }
+    }
+    if (diag->hookAddress)
+    {
+        text.Add("  hook at 0x%X, continues at 0x%X\r\n", diag->hookAddress, diag->continueAddress);
+    }
+    if (diag->status == DSRUNNER_IGR_STATUS_APPLIED)
+    {
+        text.Add("  dispatch code at 0x%X, reboot %s\r\n", diag->dispatchAddress,
+            diag->rebootCreated ? "created for the hotkey" : "shared with OS_ResetSystem");
+    }
+    if (diag->status == DSRUNNER_IGR_STATUS_NO_PATCH_SPACE)
+    {
+        text.Add("  needed %d bytes of patch space\r\n", diag->spaceNeeded);
+    }
+}
+
+void igrLog_write(const char* romPath, const nds_header_ntr_t* romHeader, bool isHomebrew,
+    const dsrunner_igr_diag_t* diag, bool hasDldiDriver)
+{
+    if (gIgrLog.bootMode == IGR_LOG_BOOT_MULTIBOOT)
+    {
+        return;
+    }
+
+    auto text = std::make_unique<IgrLogText>();
+    bool isNormalBoot = gIgrLog.bootMode == IGR_LOG_BOOT_NORMAL;
+    if (isNormalBoot)
+    {
+        text->Add("DsRunner Pico Loader: in-game reset log (rewritten on every start)\r\n");
+        text->Add("build: %s\r\n", DSRUNNER_BUILD_ID);
+    }
+    text->Add("\r\n[%s]\r\n", textOf(sBootModeTexts, gIgrLog.bootMode));
+    addRomInfo(*text, romPath, romHeader, isHomebrew);
+    text->Add("DLDI: %s\r\n", textOf(sDldiTexts, gIgrLog.dldiState));
+    if (isHomebrew)
+    {
+        text->Add("DLDI for homebrew: %s\r\n", hasDldiDriver ? "available" : "MISSING (error screen)");
+    }
+    text->Add("launcher: %s [%s]\r\n",
+        gIgrLog.launcherPath && gIgrLog.launcherPath[0] ? gIgrLog.launcherPath : "(none)",
+        textOf(sLauncherTexts, gIgrLog.launcherState));
+    text->Add("%s: %s\r\n", IN_GAME_RESET_DISABLE_PATH, gIgrLog.igrOffSeen ? "present (hotkey off)" : "absent");
+    if (diag)
+    {
+        addPatchInfo(*text, diag);
+    }
+
+    auto file = std::make_unique<FIL>();
+    BYTE mode = isNormalBoot ? (FA_CREATE_ALWAYS | FA_WRITE) : (FA_OPEN_APPEND | FA_WRITE);
+    if (f_open(file.get(), IGR_LOG_PATH, mode) != FR_OK)
+    {
+        LOG_ERROR("Failed to open %s\n", IGR_LOG_PATH);
+        return;
+    }
+    UINT bytesWritten = 0;
+    f_write(file.get(), text->GetText(), text->GetLength(), &bytesWritten);
+    f_close(file.get());
+}
diff --git a/arm7/source/fat/igrLog.h b/arm7/source/fat/igrLog.h
new file mode 100644
index 0000000..a0ef7a3
--- /dev/null
+++ b/arm7/source/fat/igrLog.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "dsrunnerIgrDiag.h"
+#include "ndsHeader.h"
+
+// DsRunner: /_pico/igr-log.txt, a short text file that tells what Pico Loader did about the
+// in-game reset (L+R+Down+B) on the last start, so it can be checked on a pc without a
+// debugger. It is rewritten on every normal start and appended to on a start after a reset.
+
+/// @brief How Pico Loader was started.
+enum IgrLogBootMode : u32
+{
+    IGR_LOG_BOOT_NORMAL = 0,
+    IGR_LOG_BOOT_IN_GAME_RESET,
+    IGR_LOG_BOOT_SOFT_RESET,
+    IGR_LOG_BOOT_MULTIBOOT
+};
+
+/// @brief What happened with the DLDI driver cache (/_pico/dldi.bin).
+enum IgrLogDldiState : u32
+{
+    IGR_LOG_DLDI_NOT_MOUNTED = 0,
+    IGR_LOG_DLDI_INIT_FAILED,
+    IGR_LOG_DLDI_SAVED,
+    IGR_LOG_DLDI_UP_TO_DATE,
+    IGR_LOG_DLDI_NOT_CACHEABLE,
+    IGR_LOG_DLDI_SAVE_FAILED,
+    IGR_LOG_DLDI_LOADED,
+    IGR_LOG_DLDI_NO_CACHE,
+    IGR_LOG_DLDI_CACHE_INVALID
+};
+
+/// @brief Where the launcher path came from (/_pico/launcher.txt).
+enum IgrLogLauncherState : u32
+{
+    IGR_LOG_LAUNCHER_NONE = 0,
+    // normal start: the path handed down by the launcher and what happened to the saved copy
+    IGR_LOG_LAUNCHER_SAVED,
+    IGR_LOG_LAUNCHER_UP_TO_DATE,
+    IGR_LOG_LAUNCHER_SAVE_FAILED,
+    IGR_LOG_LAUNCHER_EMPTY,
+    // start after an in-game reset: the path that is booted
+    IGR_LOG_LAUNCHER_FROM_HEADER,
+    IGR_LOG_LAUNCHER_FROM_FILE,
+    IGR_LOG_LAUNCHER_FALLBACK,
+    IGR_LOG_LAUNCHER_NOT_FOUND
+};
+
+/// @brief Filled in by main.cpp, dldi.cpp and launcherPathCache.cpp while Pico Loader starts.
+///        Only whole words, written before the log is.
+struct igr_log_state_t
+{
+    u32 bootMode;         // IgrLogBootMode
+    u32 dldiState;        // IgrLogDldiState
+    u32 launcherState;    // IgrLogLauncherState
+    const char* launcherPath;
+    u32 igrOffSeen;
+};
+
+extern igr_log_state_t gIgrLog;
+
+/// @brief Writes /_pico/igr-log.txt: rewrites it on a normal start, appends after a reset.
+/// @param romPath The path of the rom being started, or \c nullptr when not known.
+/// @param romHeader The header of the rom being started.
+/// @param isHomebrew Whether the rom is homebrew (no arm9 patches).
+/// @param diag The arm9 diagnostics, or \c nullptr for homebrew.
+/// @param hasDldiDriver Whether a DLDI driver can be patched into homebrew.
+/// @note Requires the card to be mounted. Never fails the start: errors are ignored.
+void igrLog_write(const char* romPath, const nds_header_ntr_t* romHeader, bool isHomebrew,
+    const dsrunner_igr_diag_t* diag, bool hasDldiDriver);
