diff --git a/common/dsrunnerIgrDiag.h b/common/dsrunnerIgrDiag.h
new file mode 100644
index 0000000..ac5326e
--- /dev/null
+++ b/common/dsrunnerIgrDiag.h
@@ -0,0 +1,87 @@
+#pragma once
+#include <nds/ndstypes.h>
+
+// DsRunner: diagnostics of the in-game reset for /_pico/igr-log.txt (see loader/README.md in
+// the DsRunner repository). The arm9 fills dsrunner_igr_diag_t while it patches a game, and
+// the arm7 asks for it with IPC_COMMAND_ARM9_DSRUNNER_GET_IGR_DIAG and writes the log.
+
+/// @brief Arm7 to arm9: send the words of dsrunner_igr_diag_t, one after the other.
+#define IPC_COMMAND_ARM9_DSRUNNER_GET_IGR_DIAG  0x20
+
+/// @brief What became of the in-game reset patch for the game being loaded.
+enum DsRunnerIgrStatus : u32
+{
+    /// @brief The arm9 patches did not run (homebrew, or not reported).
+    DSRUNNER_IGR_STATUS_NOT_RUN = 0,
+    /// @brief Left out because /_pico/igr.off exists.
+    DSRUNNER_IGR_STATUS_DISABLED,
+    /// @brief The rom has no sdk version (no module params), so no arm9 patches were made.
+    DSRUNNER_IGR_STATUS_NO_SDK_VERSION,
+    /// @brief None of the known irq dispatchers was found.
+    DSRUNNER_IGR_STATUS_NO_DISPATCHER,
+    /// @brief The game has no OS_ResetSystem and there is no sd read code to build the reboot from.
+    DSRUNNER_IGR_STATUS_NO_SD_READ_CODE,
+    /// @brief Not enough patch space left after the patches the game needs.
+    DSRUNNER_IGR_STATUS_NO_PATCH_SPACE,
+    /// @brief The hook is installed.
+    DSRUNNER_IGR_STATUS_APPLIED
+};
+
+/// @brief Result of the search for one irq dispatcher version, 4 bits each in matchResults.
+enum DsRunnerIgrMatch : u32
+{
+    DSRUNNER_IGR_MATCH_NOT_TRIED = 0,
+    /// @brief The instruction pattern does not occur.
+    DSRUNNER_IGR_MATCH_NO_MATCH,
+    /// @brief The pattern occurs more than once.
+    DSRUNNER_IGR_MATCH_AMBIGUOUS,
+    /// @brief sdk: the start of the dispatcher (push {lr}; mov r12, #0x04000000; ...) was not found.
+    DSRUNNER_IGR_MATCH_START_NOT_FOUND,
+    /// @brief sdk: the literal return address does not match the relocated location.
+    DSRUNNER_IGR_MATCH_RETURN_MISMATCH,
+    /// @brief sdk: the irq table address is invalid.
+    DSRUNNER_IGR_MATCH_BAD_TABLE,
+    /// @brief Found and used.
+    DSRUNNER_IGR_MATCH_MATCHED,
+    /// @brief The pattern was found, but a later check rejected it.
+    DSRUNNER_IGR_MATCH_REJECTED
+};
+
+/// @brief Index of each dispatcher version in matchResults (bits 4 * index).
+#define DSRUNNER_IGR_VARIANT_SDK            0
+#define DSRUNNER_IGR_VARIANT_BLX            1
+#define DSRUNNER_IGR_VARIANT_NESTED         2
+#define DSRUNNER_IGR_VARIANT_COND_RETURN    3
+#define DSRUNNER_IGR_VARIANT_COUNT          4
+
+/// @brief Only whole words: the arm9 runs from vram, where 8-bit writes have no effect.
+typedef struct
+{
+    u32 sdkVersion;
+    u32 status;            // DsRunnerIgrStatus
+    u32 matchResults;      // DsRunnerIgrMatch per dispatcher version, 4 bits each
+    u32 sdkPatternCount;   // how often the stock dispatcher pattern occurs
+    u32 hookAddress;       // overwritten dispatcher instructions (load address), or 0
+    u32 continueAddress;   // where the dispatch part carries on (final address), or 0
+    u32 dispatchAddress;   // the dispatch part in the patch heap, or 0
+    u32 osResetSystem;     // end of OS_ResetSystem found in the game, or 0
+    u32 rebootCreated;     // 1 when the reboot was created for the in-game reset
+    u32 spaceNeeded;       // bytes the in-game reset needed when it did not fit, otherwise 0
+    u32 platform[4];       // PICO_PLATFORM name, NUL padded
+} dsrunner_igr_diag_t;
+
+#define DSRUNNER_IGR_DIAG_WORDS     (sizeof(dsrunner_igr_diag_t) / sizeof(u32))
+
+#ifdef ARM9
+#ifdef __cplusplus
+extern dsrunner_igr_diag_t gDsRunnerIgrDiag;
+/// @brief Result of the last FindUniqueIrqDispatcherPattern call (DsRunnerIgrMatch).
+extern u32 gDsRunnerIgrLastPatternResult;
+
+static inline void dsrunnerIgrDiag_setMatch(u32 variant, u32 result)
+{
+    gDsRunnerIgrDiag.matchResults = (gDsRunnerIgrDiag.matchResults & ~(0xFu << (variant * 4)))
+        | (result << (variant * 4));
+}
+#endif
+#endif
