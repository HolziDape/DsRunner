+// DsRunner: records the result of one dispatcher search. A failed search that found its
+// pattern once was rejected by a later check, unless the search named the reason itself.
+static bool recordSearch(u32 variant, bool found)
+{
+    u32 result = gDsRunnerIgrLastPatternResult;
