 ///        for it simply ignores the extra argument.
 #define IN_GAME_RESET_LAUNCHER_ARGUMENT         "igr"
+
+/// @brief DsRunner: when this file exists on the card, the in-game reset patch is not applied.
+///        DsRunner creates or deletes it according to its setting "inGameReset".
+#define IN_GAME_RESET_DISABLE_PATH              "/_pico/igr.off"
+
+/// @brief DsRunner: flag in the flags word of IPC_COMMAND_ARM9_SET_ROM_FILE_INFO.
+#define IN_GAME_RESET_ROM_FILE_INFO_FLAG_DISABLED   4
