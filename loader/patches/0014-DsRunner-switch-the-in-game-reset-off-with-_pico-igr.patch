 arm9/source/Arm9Patcher.cpp      | 12 ++++++++----
 arm9/source/Arm9Patcher.h        |  3 ++-
 arm9/source/main.cpp             |  6 +++++-
 common/inGameReset.h             |  7 +++++++
 5 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/arm7/source/loader/NdsLoader.cpp b/arm7/source/loader/NdsLoader.cpp
