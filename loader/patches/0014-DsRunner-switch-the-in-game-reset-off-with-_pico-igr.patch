--- a/arm7/source/loader/NdsLoader.cpp
+++ b/arm7/source/loader/NdsLoader.cpp
@@ -1,4 +1,5 @@
 #include "common.h"
+#include <memory>
 #include <string.h>
 #include <libtwl/rtos/rtosIrq.h>
 #include <libtwl/sys/swi.h>
@@ -28,6 +29,7 @@
 #include "Arm7IoRegisterClearer.h"
 #include "PatchListFactory.h"
 #include "CheatPreprocessor.h"
+#include "inGameReset.h" // DsRunner
 #include "NdsLoader.h"
 
 #define AP_LIST_PATH      "/_pico/aplist.bin"
@@ -40,6 +42,15 @@ static const InverseKmpMatcher sDldiStubMatcher { (const u32[]) { ~0xBF8DA5EDu,
 
 void NdsLoader::Load(BootMode bootMode)
 {
+    // DsRunner: checked before the rom file is opened, so the directory sector of the rom stays in the fat window
+    auto fileInfo = std::make_unique<FILINFO>();
+    bool inGameResetDisabled = f_stat(IN_GAME_RESET_DISABLE_PATH, fileInfo.get()) == FR_OK;
+    fileInfo.reset();
+    if (inGameResetDisabled)
+    {
+        LOG_DEBUG("In-game reset disabled by %s\n", IN_GAME_RESET_DISABLE_PATH);
+    }
+
     if (bootMode == BootMode::Normal)
     {
         LOG_DEBUG("Loading %s\n", _romPath);
@@ -196,7 +207,8 @@ void NdsLoader::Load(BootMode bootMode)
     sendToArm9(IPC_COMMAND_ARM9_SET_ROM_FILE_INFO);
     sendToArm9(isHomebrew ? 0 : _romFile.dir_sect);
     sendToArm9(isHomebrew ? 0 : (u32)(_romFile.dir_ptr - _romFile.obj.fs->win));
-    sendToArm9((isCloneBootRom ? 1 : 0) | (_runInDSiMode ? 2 : 0));
+    sendToArm9((isCloneBootRom ? 1 : 0) | (_runInDSiMode ? 2 : 0)
+        | (inGameResetDisabled ? IN_GAME_RESET_ROM_FILE_INFO_FLAG_DISABLED : 0)); // DsRunner
 
     if (!isHomebrew)
     {
diff --git a/arm9/source/Arm9Patcher.cpp b/arm9/source/Arm9Patcher.cpp
index e54b314..40a8220 100644
--- a/arm9/source/Arm9Patcher.cpp
+++ b/arm9/source/Arm9Patcher.cpp
@@ -49,7 +49,7 @@ static const u32 sMiiUncompressBackwardPattern[] = { 0xE3500000, 0x0A000027, 0xE
 static const u32 sMiiUncompressBackwardPatternHybrid[] = { 0xE3500000, 0x0A000029, 0xE92D01F0, 0xE9100006 };
 
 Arm9Patcher::PatchResult Arm9Patcher::ApplyPatches(const LoaderPlatform* loaderPlatform, const ApListEntry* apListEntry,
-    bool isCloneBootRom, bool runInDSiMode, const loader_info_t* loaderInfo) const
+    bool isCloneBootRom, bool runInDSiMode, const loader_info_t* loaderInfo, bool inGameResetEnabled) const
 {
     auto romHeader = (const nds_header_ntr_t*)TWL_SHARED_MEMORY->ntrSharedMem.romHeader;
     auto twlRomHeader = (const nds_header_twl_t*)TWL_SHARED_MEMORY->twlRomHeader;
@@ -232,9 +232,13 @@ Arm9Patcher::PatchResult Arm9Patcher::ApplyPatches(const LoaderPlatform* loaderP
         bool hasRomReadPatches = !(sdkVersion.IsTwlSdk() && twlRomHeader->IsDsiWare());
         // The reboot reuses the sd read code that the rom read patches create. It does not
         // exist for DSiWare, or on platforms that read roms directly instead of from the sd card.
-        patchCollection.AddPatch(new InGameResetPatch(osResetSystemPatch, loaderInfo,
-            sdkVersion.IsTwlSdk() && isHybridRom && runInDSiMode,
-            hasRomReadPatches && !loaderPlatform->HasRomReads()));
+        // DsRunner: left out when switched off with IN_GAME_RESET_DISABLE_PATH
+        if (inGameResetEnabled)
+        {
+            patchCollection.AddPatch(new InGameResetPatch(osResetSystemPatch, loaderInfo,
+                sdkVersion.IsTwlSdk() && isHybridRom && runInDSiMode,
+                hasRomReadPatches && !loaderPlatform->HasRomReads()));
+        }
 
         if (moduleParams && compressedEnd != 0)
         {
