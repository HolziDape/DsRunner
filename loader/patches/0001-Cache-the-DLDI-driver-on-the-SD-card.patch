diff --git a/arm7/source/main.cpp b/arm7/source/main.cpp
index 96c2122..b95469e 100644
--- a/arm7/source/main.cpp
+++ b/arm7/source/main.cpp
@@ -183,7 +183,12 @@ extern "C" void loaderMain()
         {
             if (dldi_init())
             {
-                mountDldi();
+                // The driver cache depends only on whether a driver was handed down,
