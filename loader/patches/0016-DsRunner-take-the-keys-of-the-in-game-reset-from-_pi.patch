 /// @brief DsRunner: flag in the flags word of IPC_COMMAND_ARM9_SET_ROM_FILE_INFO.
 #define IN_GAME_RESET_ROM_FILE_INFO_FLAG_DISABLED   4
+
+/// @brief DsRunner: keys of the in-game reset, as the bits of REG_KEYINPUT that read 0 while
+///        held. The default is L + R + Down + B: bit 9 = L, bit 8 = R, bit 7 = Down, bit 1 = B.
+///        The arm9 can only read A, B, Select, Start, Right, Left, Up, Down, R and L (bits 0-9).
+#define IN_GAME_RESET_DEFAULT_KEY_MASK              0x382
+#define IN_GAME_RESET_KEY_MASK_VALID_BITS           0x3FF
+
+/// @brief DsRunner: when this file exists, its first line holds the key mask as a hexadecimal
+///        number ("0x08C" = SELECT + START + DOWN, etc.), which replaces IN_GAME_RESET_DEFAULT_KEY_MASK. DsRunner writes
+///        it from its setting "inGameResetKeys" and deletes it for the default keys.
+#define IN_GAME_RESET_KEYS_PATH                     "/_pico/igr.keys"
+
+/// @brief DsRunner: the key mask travels in bits 16-25 of the same flags word; 0 = default.
+#define IN_GAME_RESET_ROM_FILE_INFO_KEY_MASK_SHIFT  16
