diff --git a/arm9/source/patches/arm9/InGameReset/InGameResetPatchCode.s b/arm9/source/patches/arm9/InGameReset/InGameResetPatchCode.s
index afe80e7..3281adb 100644
--- a/arm9/source/patches/arm9/InGameReset/InGameResetPatchCode.s
+++ b/arm9/source/patches/arm9/InGameReset/InGameResetPatchCode.s
@@ -1,10 +1,9 @@
 .cpu arm946e-s
 .syntax unified
 
-// DsRunner: L + R + Down + B held for two seconds, as documented in the DsRunner README.
-// L + R + Down + B, as the bits that read 0 in REG_KEYINPUT while held.
-// Bit 9 = L, bit 8 = R, bit 7 = Down, bit 1 = B, giving 0x382.
