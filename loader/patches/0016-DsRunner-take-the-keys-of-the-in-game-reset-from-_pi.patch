 igr_log_state_t gIgrLog;
 
+/// @brief Names of the REG_KEYINPUT bits 0-9, as DsRunner writes them in "inGameResetKeys".
+static const char* const sKeyNames[] =
+{
+    "A", "B", "SELECT", "START", "RIGHT", "LEFT", "UP", "DOWN", "R", "L"
+};
+
+u32 igrKeys_read()
+{
+    auto file = std::make_unique<FIL>();
+    if (f_open(file.get(), IN_GAME_RESET_KEYS_PATH, FA_READ) != FR_OK)
+    {
+        return 0;
+    }
+    char text[16];
+    UINT bytesRead = 0;
+    FRESULT result = f_read(file.get(), text, sizeof(text) - 1, &bytesRead);
+    f_close(file.get());
+    if (result != FR_OK)
+    {
+        return 0;
+    }
+    text[bytesRead] = 0;
+
+    // "0x" followed by hexadecimal digits, up to the first character that is not one
+    const char* digit = text;
+    if (digit[0] == '0' && (digit[1] == 'x' || digit[1] == 'X'))
+    {
+        digit += 2;
+    }
+    u32 keyMask = 0;
+    u32 digits = 0;
+    for (; *digit != 0 && digits < 8; digit++, digits++)
+    {
+        char c = *digit;
+        u32 value;
+        if (c >= '0' && c <= '9')
+            value = c - '0';
+        else if (c >= 'a' && c <= 'f')
+            value = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F')
+            value = c - 'A' + 10;
+        else
+            break;
+        keyMask = (keyMask << 4) | value;
+    }
+    if (digits == 0 || keyMask == 0 || (keyMask & ~IN_GAME_RESET_KEY_MASK_VALID_BITS) != 0)
+    {
+        LOG_ERROR("Invalid %s, using the default keys\n", IN_GAME_RESET_KEYS_PATH);
+        return 0;
+    }
+    return keyMask;
+}
+
+void igrKeys_format(u32 keyMask, char* buffer, u32 bufferSize)
+{
+    // same order as DsRunner writes them: L, R, SELECT, START, UP, DOWN, LEFT, RIGHT, A, B
+    static const u8 sOrder[] = { 9, 8, 2, 3, 6, 7, 5, 4, 0, 1 };
+    u32 length = 0;
+    buffer[0] = 0;
+    for (u32 i : sOrder)
+    {
+        if (keyMask & (1u << i))
+        {
+            length += mini_snprintf(buffer + length, bufferSize - length, "%s%s",
+                length == 0 ? "" : "+", sKeyNames[i]);
+            if (length >= bufferSize - 1)
+                break;
+        }
+    }
+}
+
 static const char* const sBootModeTexts[] =
 {
     "normal start",
@@ -165,6 +236,7 @@ static void addPatchInfo(IgrLogText& text, const dsrunner_igr_diag_t* diag)
     {
